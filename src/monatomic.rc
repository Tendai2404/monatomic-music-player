// Monatomic Music Player — Windows resources.
// Compiled with rc.exe and linked so the exe carries the app icon
// (Explorer, taskbar, Alt-Tab) and basic version info.

#include <winver.h>

// IDI_APPICON must be the FIRST icon (lowest id) so Explorer picks it.
1 ICON "..\\assets\\monatomic.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Monatomic"
            VALUE "FileDescription", "Monatomic Music Player"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "monatomic"
            VALUE "OriginalFilename", "monatomic.exe"
            VALUE "ProductName", "Monatomic Music Player"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
